# Copy of the settings the site needs. Do NOT put real values in this file.
# Real values live in Vercel → Project → Settings → Environment Variables,
# and `vercel env pull .env.local` copies them to your computer for local testing.

# Added automatically when you connect a Neon database in Vercel.
DATABASE_URL=

# The password staff type on /admin.html. Make it long (e.g. 4+ random words).
ADMIN_PASSWORD=

# A long random string used to sign the staff login cookie (32+ characters).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
