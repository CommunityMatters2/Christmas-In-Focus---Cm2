# The settings the site needs. Do NOT put real values in this file (it IS pushed to GitHub).
# Real values go in .env on your computer (git-ignored) and in
# Vercel → Project → Settings → Environment Variables.

# Supabase → Connect → "Transaction pooler" URI (port 6543), with your DB password filled in.
DATABASE_URL=

# The password staff type on /admin.html. Make it long (e.g. 4+ random words).
ADMIN_PASSWORD=

# A long random string used to sign the staff login cookie (32+ characters).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional — not used by this site (the browser never talks to Supabase directly).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Booking emails (Resend: resend.com) ---
# Resend → API Keys → Create API key (Sending access). Starts with re_
RESEND_API_KEY=

# Who the emails come from. The domain must be verified in Resend → Domains
# (communitymatters2.org). Leave EMPTY until it is: Resend's test sender is used,
# which can ONLY deliver to the email address that owns the Resend account.
# Example: CM2 Christmas in Focus <bookings@communitymatters2.org>
EMAIL_FROM=

# Optional: where "new booking" emails go. Defaults to the contact email in public/config.js.
OFFICE_EMAIL=

# Optional: the public address used for links and the logo in emails,
# e.g. https://christmasinfocuscm2.vercel.app
SITE_URL=
