# The settings the site needs. Do NOT put real values in this file (it IS pushed to GitHub).
# Real values go in .env on your computer (git-ignored) and in
# Vercel → Project → Settings → Environment Variables.

# Supabase → Connect → "Transaction pooler" URI (port 6543), with your DB password filled in.
DATABASE_URL=

# The password staff type on /admin.html. Make it long (e.g. 4+ random words).
ADMIN_PASSWORD=

# A long random string used to sign the staff login cookie (32+ characters).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional — not used by this site (the browser never talks to Supabase directly).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Stripe payments ($20 per window, set in public/config.js) ---
# Stripe Dashboard → Developers → API keys → Secret key.
# Sandbox/test: sk_test_...   Live (real money): sk_live_...
STRIPE_SECRET_KEY=

# Stripe Dashboard → Developers → Webhooks → your endpoint → Signing secret (whsec_...).
# Endpoint URL: https://YOUR-SITE/api/stripe-webhook
# Events: checkout.session.completed, checkout.session.async_payment_succeeded, checkout.session.expired
# Test and live mode each have their OWN webhook and their OWN whsec_ secret.
STRIPE_WEBHOOK_SECRET=

# Optional: the public address families use, e.g. https://book.cm2.org
# (where Stripe sends them back after paying). Defaults to the address they came in on.
SITE_URL=
